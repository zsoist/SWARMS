# Copia este archivo a .env y pon tus llaves. .env NUNCA se sube a git.
#
# No necesitas todas: con UNA sola de las dos primeras ya tienes enjambre.

# OpenRouter — la más versátil: una sola llave da acceso a cientos de modelos.
# Sácala en https://openrouter.ai/keys
OPENROUTER_API_KEY=

# DeepSeek nativo — más barato y con mucha más concurrencia (2.500 simultáneas
# contra las ~20 por minuto del plan gratuito de OpenRouter).
# Sácala en https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Anthropic — opcional, solo si quieres un modelo Claude como planificador.
# El presupuesto está en 0 por defecto: hay que subirlo A PROPÓSITO.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# Cambia toda la tropa sin tocar código ni YAML:
# WORKER_MODEL=z-ai/glm-5.3-flash
