# Copy this file to .env (in your project) or to ~/.enjambre.env (for all projects).
# Never put .env in git.
#
# You need only ONE of the two keys below.

# DeepSeek: cheap, and many calls at the same time.
# Get it at https://platform.deepseek.com → API keys.
# If this is the only key, the fleet is DeepSeek.
DEEPSEEK_API_KEY=

# OpenRouter: one key for hundreds of models. It also enables the judge (Jev).
# Get it at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# If another app (for example a public site) uses the same key, give the swarm its own key.
# Then the swarm does not use the daily limit of the other app. This key wins over the one above.
# ENJAMBRE_OPENROUTER_KEY=

# Fleet: deepseek or glm. See README.md.
# ENJAMBRE=deepseek

# Spend limit for each run, in USD.
# DEEPSEEK_BUDGET_USD=5

# Change the worker model without code changes:
# WORKER_MODEL=deepseek-flash

# Anthropic: optional. Only to use a Claude model as the brain inside the swarm.
# The budget is 0 by default. You must increase it on purpose.
# ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=
